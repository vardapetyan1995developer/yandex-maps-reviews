APP_NAME="Yandex Reviews"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database --------------------------------------------------------------
# MAMP defaults to port 8889; docker-compose uses 3306 with host "mysql".
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=8889
DB_DATABASE=yandex_reviews
DB_USERNAME=root
DB_PASSWORD=root

# --- Session, cache, queue -------------------------------------------------
# Sanctum in SPA mode runs on a session cookie, so the session driver must be
# shared across every application process (database or redis).
SESSION_DRIVER=database
SESSION_LIFETIME=120
# null binds the cookie to the request host; set a domain explicitly only when
# the frontend and the API live on different subdomains.
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
# Must exceed the parse job's timeout (600 s): a job still running past this
# point is handed to a second worker as if the first had died.
DB_QUEUE_RETRY_AFTER=660

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- Sanctum ---------------------------------------------------------------
# Domains whose requests receive a session cookie. These must match the
# frontend's real address, otherwise login returns 419.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,localhost:5173,127.0.0.1,127.0.0.1:8000
FRONTEND_URL=http://localhost:8000

# --- Seeded user -----------------------------------------------------------
# The application has no sign-up flow; the account is created by the seeder.
SEED_USER_NAME="Демо-пользователь"
SEED_USER_EMAIL=demo@example.com
SEED_USER_PASSWORD=password

# --- Scraping --------------------------------------------------------------
SCRAPING_TIMEOUT=30
SCRAPING_CONNECT_TIMEOUT=10

# The pause between requests is chosen at random from this range: an even
# interval is itself a sign of automation.
SCRAPING_DELAY_MIN_MS=400
SCRAPING_DELAY_MAX_MS=1200

# Comma-separated proxy list, for example:
# SCRAPING_PROXIES=http://user:pass@1.2.3.4:8080,http://user:pass@5.6.7.8:8080
SCRAPING_PROXIES=
SCRAPING_PROXY_COOLDOWN=900

# Listing order: by_time gives a stable sequence between runs.
SCRAPING_YANDEX_RANKING=by_time
# Yandex's own output depth limit — requests past this boundary are rejected.
SCRAPING_YANDEX_MAX_REVIEWS=600

# --- Fallback strategy (headless browser) ----------------------------------
# Requires Node and `npx playwright install chromium`. Disabled by default;
# needed only if Yandex changes the internal API contract.
SCRAPING_HEADLESS_ENABLED=false
SCRAPING_NODE_BINARY=node
SCRAPING_HEADLESS_TIMEOUT=300
